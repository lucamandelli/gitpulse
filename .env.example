# Copy to .env and adjust. Used by docker-compose and apps on the host (localhost).

# --- PostgreSQL (docker-compose postgres service + host apps) ---
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database
POSTGRES_PORT=5432

# Host-side connection string (app on your machine; inside Compose use host "postgres" instead of localhost).
DATABASE_URL=postgresql://your_user:your_secure_password@localhost:5432/your_database

# --- Redis (host apps: REDIS_HOST=localhost; inside Compose use REDIS_HOST=redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# --- Bull Board UI (venatum/bull-board; Compose maps this port to the container) ---
BULL_BOARD_PORT=3001
# Queue key prefix and library: BULLMQ or BULL (must match your app)
BULL_PREFIX=bull
BULL_VERSION=BULLMQ

# Optional: protect the Bull Board UI (both must be set to enable login)
# BULL_BOARD_USER_LOGIN=
# BULL_BOARD_USER_PASSWORD=
