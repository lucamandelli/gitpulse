# Postgres
POSTGRES_USER=gitpulse
POSTGRES_PASSWORD=gitpulse
POSTGRES_DB=gitpulse

# API
# DATABASE_URL is constructed automatically by docker-compose from the Postgres vars above.
# If running the API outside Docker, set this manually, e.g.:
# DATABASE_URL=postgresql://gitpulse:gitpulse@localhost:5432/gitpulse
API_PORT=3333

# Web
VITE_API_URL=http://localhost:3333
WEB_PORT=3000

# BetterAuth
# Generate a random secret with at least 32 chars, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# GitHub OAuth — create app at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3333/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CORS — origin allowed to make cross-origin requests to the API
CORS_ORIGIN=http://localhost:3000
