# Postgres
POSTGRES_USER=gitpulse
POSTGRES_PASSWORD=gitpulse
POSTGRES_DB=gitpulse

# API
# DATABASE_URL is constructed automatically by docker-compose from the Postgres vars above.
# If running the API outside Docker, set this manually, e.g.:
# DATABASE_URL=postgresql://gitpulse:gitpulse@localhost:5432/gitpulse
API_PORT=3333

# Web
VITE_API_URL=http://localhost:3333
WEB_PORT=3000
